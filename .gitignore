# Generated data: SQLite db, art crops, EDHREC cache, Scryfall bulk dumps.
data/

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# Training exports land at the repo root by default (Phase 12).
# Root-anchored so eval/queries.jsonl stays committed.
/*.jsonl

# Phase 12 training exports: `export-training --out` defaults to exports/,
# holding <target>_train.jsonl and <target>_val.jsonl.
exports/

# Phase 11 eval run artifacts (one timestamped JSON per run).
# eval/queries.jsonl is the committed dataset and stays tracked.
eval/results/

# Belt and braces. The serving layer's secrets live in
# ~/.config/scrying-pool/bot.env — outside the repo entirely, precisely so a
# token can never ride along in a `git add -A`. This line is the second layer,
# for anyone who drops a .env in here anyway.
*.env
